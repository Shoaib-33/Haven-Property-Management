# Copy this file to .env, then enter the SMTP details supplied by your email provider.
# Do not commit or share your real .env file.
HAVEN_SMTP_HOST=
HAVEN_SMTP_PORT=587
HAVEN_SMTP_FROM=
HAVEN_SMTP_USERNAME=
HAVEN_SMTP_PASSWORD=
HAVEN_SMTP_STARTTLS=1
HAVEN_SMTP_SSL=0
HAVEN_PUBLIC_URL=http://127.0.0.1:8000

# Help assistant (chat bubble). Free key: https://aistudio.google.com/apikey
# Leave empty to use the built-in keyword guide instead.
GROQ_API_KEY=
HAVEN_GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
# Optional. The default alias always points at Google's newest Flash model.
HAVEN_GEMINI_MODEL=gemini-flash-latest

# The timezone whose date Haven shows (servers often run on UTC). Leave empty to use this computer's own date.
HAVEN_TIMEZONE=
